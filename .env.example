# 网易云音乐凭证
NCM_MUSIC_U=your_music_u_cookie_here

# Apple Music 凭证 (可通过 music.apple.com 控制台一键提取)
AM_DEVELOPER_TOKEN=eyJhbGciOi...
AM_MUSIC_USER_TOKEN=your_media_user_token_here
AM_STOREFRONT=cn

# 歌单同步配置
# mode 可选: "archive" (每日新建，如 "网易云日推 - 2026-09-18") 或 "overwrite" (单歌单查重追加更新)
SYNC_MODE=archive
PLAYLIST_OVERWRITE_NAME=网易云每日推荐
PLAYLIST_ARCHIVE_PREFIX=网易云日推 - 
PLAYLIST_DESCRIPTION=由自动化任务每日自动同步网易云音乐每日推荐
